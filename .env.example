# Copy this file to .env. Fill at least one LLM key; the first one set is used
# (Qwen, then Groq, Anthropic, Gemini, OpenAI). Delete the ones you don't use.

# Qwen through ModelScope's OpenAI-compatible API.
# Available models: Qwen-Ambassador/Qwen3.7-Max, Qwen-Ambassador/Qwen3.8-Max,
# Qwen-Ambassador/Qwen3.7-Plus, Qwen-Ambassador/Qwen3.8-plus
QWEN_API_KEY=your-modelscope-key-here
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
# Writes the answers.
QWEN_CHAT_MODEL=Qwen-Ambassador/Qwen3.7-Max
# Only decides whether a message is a question, a triage request or urgent; a lighter model is enough.
QWEN_ROUTER_MODEL=Qwen-Ambassador/Qwen3.7-Plus

GROQ_API_KEY=your-groq-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here

CORS_ORIGINS=http://localhost:5173


# Africa's Talking USSD
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=your-africas-talking-username

# Meta WhatsApp
WHATSAPP_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret

# CHW live handoff (notify staff WhatsApp numbers)
CHW_NOTIFY_NUMBERS=254712345001,254712345002

# Infrastructure
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://contrabot:contrabot@localhost:5432/contrabot

APP_ENV=development
PORT=8000
DEBUG=true
